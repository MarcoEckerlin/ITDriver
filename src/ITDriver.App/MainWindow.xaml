<Window x:Class="ITDriver.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ITDriver.App"
        Title="ITDriver – Treiber-Updater" Height="780" Width="1240" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Page}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        Icon="Assets/itdriver.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Background="{StaticResource Sidebar}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,0,24">
                <Image Source="Assets/itdriver.ico" Width="34" Height="34"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="ITDriver" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="kostenlos &amp; quelloffen" Foreground="{StaticResource NavMuted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,18">
                <Button Style="{StaticResource Primary}" Margin="0,0,0,10" Click="InstallAppUpdate_Click"
                        Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVis}}" Content="{Binding AppUpdateText}"/>
                <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource NavMuted}" FontSize="11"/>
            </StackPanel>
            <StackPanel x:Name="Nav">
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE80F;" Content="Übersicht" IsChecked="True" Checked="Nav_Checked" Tag=""/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE895;" Content="Updates" Checked="Nav_Checked" Tag="{Binding UpdateBadge}"/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE772;" Content="Geräte" Checked="Nav_Checked" Tag="{Binding ProblemBadge}"/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xEA80;" Content="Empfehlungen" Checked="Nav_Checked" Tag="{Binding RecommendationBadge}"/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE8F1;" Content="Backup &amp; Wiederherstellung" Checked="Nav_Checked" Tag=""/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE74D;" Content="Bereinigung" Checked="Nav_Checked" Tag=""/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE81C;" Content="Verlauf" Checked="Nav_Checked" Tag=""/>
                <RadioButton Style="{StaticResource Nav}" local:NavProps.Glyph="&#xE713;" Content="Einstellungen" Checked="Nav_Checked" Tag=""/>
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <DockPanel Grid.Column="1">
            <!-- Status bar -->
            <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Abbrechen" Click="Cancel_Click" Margin="0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <ProgressBar DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="True" Margin="12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <TabControl x:Name="Pages" BorderThickness="0" Background="Transparent" Padding="28,24">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- 0 Übersicht -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}" Padding="28">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Left" Width="74" Height="74" Margin="0,0,24,0" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding HealthColor}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SummaryTitle}" Style="{StaticResource H1}"/>
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Sub}"/>
                                        <TextBlock Text="{Binding WindowsUpdateError}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,0,0,12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Big}" Content="Jetzt scannen" Click="Scan_Click" IsEnabled="{Binding IsIdle}"/>
                                            <Button Content="Alle Updates installieren" Padding="20,12" FontSize="14" Click="InstallAll_Click" IsEnabled="{Binding IsIdle}"
                                                    Visibility="{Binding HasScan, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastScanText}" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,7,14">
                                    <StackPanel>
                                        <TextBlock Text="Dein System" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{Binding SystemLine}" TextWrapping="Wrap" LineHeight="22"/>
                                        <TextBlock Text="Starte einen Scan, um die Systeminformationen zu sehen." Foreground="{StaticResource Muted}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScan}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="7,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Sicher aktualisieren" Style="{StaticResource H2}"/>
                                        <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="{StaticResource Muted}">
                                            ✔ Treiber nur aus Windows Update und von offiziellen Herstellerseiten<LineBreak/>
                                            ✔ Wiederherstellungspunkt vor jeder Installation<LineBreak/>
                                            ✔ Backup des alten Treibers und Zurücksetzen mit einem Klick<LineBreak/>
                                            ✔ Keine Werbung, keine Bezahlschranke, Open Source
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="Komplettes Treiber-Backup" Click="BackupAll_Click" IsEnabled="{Binding IsIdle}"/>
                                            <Button Content="Bericht exportieren" Click="ExportReport_Click" IsEnabled="{Binding HasScan}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 1 Updates -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Treiber-Updates" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Fehlende und veraltete Treiber aus Windows Update und dem Microsoft Update-Katalog. Vor der Installation erstellt ITDriver einen Wiederherstellungspunkt und sichert den alten Treiber."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource Primary}" Content="Ausgewählte installieren" Click="InstallSelected_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Alle auswählen" Click="SelectAll_Click"/>
                                <Button Content="Keine auswählen" Click="SelectNone_Click"/>
                                <Button Content="Ignorieren" Click="Ignore_Click"/>
                                <Button Content="Details / Katalog" Click="UpdateInfo_Click"/>
                                <Button Content="Neu scannen" Click="Scan_Click" IsEnabled="{Binding IsIdle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Expander DockPanel.Dock="Bottom" Header="Ignorierte Updates" Margin="0,10,0,0">
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Wieder anzeigen" Click="Unignore_Click" VerticalAlignment="Top" Margin="8,0,0,0"/>
                                <ListBox x:Name="IgnoredList" ItemsSource="{Binding IgnoredUpdates}" DisplayMemberPath="Title" Height="90"/>
                            </DockPanel>
                        </Expander>
                        <DataGrid x:Name="UpdatesGrid" ItemsSource="{Binding Updates}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Art" Binding="{Binding KindText}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Gerät" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Installiert" Binding="{Binding InstalledVersion}" Width="115" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Neue Version" Binding="{Binding NewVersion}" Width="115" IsReadOnly="True"/>
                                <DataGridTextColumn Header="vom" Binding="{Binding DriverDate, StringFormat=dd.MM.yyyy}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Quelle" Binding="{Binding SourceText}" Width="150" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="1.2*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                            <DataGrid.RowDetailsTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Margin="44,2,8,6" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGrid.RowDetailsTemplate>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 2 Geräte -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Geräte &amp; Treiber" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Alle erkannten Geräte mit ihrem aktuellen Treiber. Für Geräte ohne Windows-Update-Angebot führen die Links direkt zum Hersteller oder zum Microsoft Update-Katalog."/>
                            <DockPanel Margin="0,0,0,12">
                                <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding DeviceFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Suchen nach Name, Klasse, Hersteller oder Hardware-ID"/>
                                <CheckBox Content="Nur Probleme" IsChecked="{Binding OnlyProblems}" Margin="14,0,0,0"/>
                                <CheckBox Content="Virtuelle Geräte ausblenden" IsChecked="{Binding HideVirtual}" Margin="14,0,0,0"/>
                                <CheckBox Content="Nicht angeschlossene zeigen" IsChecked="{Binding ShowHidden}" Margin="14,0,0,0"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Herstellerseite" Click="DeviceVendor_Click"/>
                                <Button Content="Im Update-Katalog suchen" Click="DeviceCatalog_Click"/>
                                <Button Content="Treiber sichern" Click="DeviceBackup_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Hardware-IDs kopieren" Click="DeviceCopy_Click"/>
                                <Button Content="Geräte-Manager" Click="DevMgmt_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid x:Name="DevicesGrid" ItemsSource="{Binding DevicesView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="100"/>
                                <DataGridTextColumn Header="Gerät" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Hersteller" Binding="{Binding VendorName}" Width="120"/>
                                <DataGridTextColumn Header="Treiber" Binding="{Binding DriverVersion}" Width="120"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding DriverDate, StringFormat=dd.MM.yyyy}" Width="80"/>
                                <DataGridTextColumn Header="Anbieter" Binding="{Binding DriverProvider}" Width="110"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding ProblemText}" Width="1.3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 3 Empfehlungen -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Empfehlungen" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Was Windows Update nicht abdeckt: fehlende Treiber, Standardtreiber, veraltete Grafiktreiber und die offiziellen Tools deines PC- und Hardware-Herstellers."/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Recommendations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Padding="16">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{Binding UrlText}" Tag="{Binding Url}" Click="OpenUrl_Click" VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Url}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Border DockPanel.Dock="Left" CornerRadius="4" Padding="8,3" Margin="0,0,14,0" VerticalAlignment="Top">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E7F0FD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Important">
                                                                    <Setter Property="Background" Value="#FDE7E7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Recommended">
                                                                    <Setter Property="Background" Value="#FFF3DC"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                                <StackPanel Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- 4 Backup -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Backup &amp; Wiederherstellung" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Sichere deine Treiber, z. B. vor einer Windows-Neuinstallation. Ein ZIP-Export enthält ein Skript, mit dem du die Treiber auch ohne ITDriver wieder einspielen kannst."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource Primary}" Content="Alle Treiber sichern" Click="BackupAll_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Wiederherstellen" Click="RestoreBackup_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Als ZIP exportieren" Click="ExportBackup_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Ordner öffnen" Click="OpenBackup_Click"/>
                                <Button Content="Löschen" Click="DeleteBackup_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Wiederherstellungspunkt erstellen" Click="RestorePoint_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Systemwiederherstellung öffnen" Click="SystemRestore_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid x:Name="BackupsGrid" ItemsSource="{Binding Backups}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Erstellt" Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                                <DataGridTextColumn Header="Art" Binding="{Binding Label}" Width="*"/>
                                <DataGridTextColumn Header="Pakete" Binding="{Binding PackageCount}" Width="80"/>
                                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="90"/>
                                <DataGridTextColumn Header="Ordner" Binding="{Binding Folder}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 5 Bereinigung -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Treiberspeicher bereinigen" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Windows behält alte Treiberversionen im Treiberspeicher. ITDriver findet ältere Duplikate, die kein Gerät mehr nutzt. Pakete in Benutzung oder für den Start wichtige Treiber werden nie entfernt."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource Primary}" Content="Analysieren" Click="AnalyzeCleanup_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Ausgewählte entfernen" Click="RunCleanup_Click" IsEnabled="{Binding IsIdle}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CleanupSummary}" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Cleanup}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Paket" Binding="{Binding Name}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="INF" Binding="{Binding Inf}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Anbieter" Binding="{Binding Provider}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Klasse" Binding="{Binding Class}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Neuere Version" Binding="{Binding NewerVersion}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="80" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 6 Verlauf -->
                <TabItem>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Verlauf" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Alle Änderungen durch ITDriver. Macht ein neuer Treiber Probleme, setze ihn hier zurück oder nutze den Wiederherstellungspunkt."/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Style="{StaticResource Primary}" Content="Ausgewählten Treiber zurücksetzen" Click="Rollback_Click" IsEnabled="{Binding IsIdle}"/>
                                <Button Content="Systemwiederherstellung öffnen" Click="SystemRestore_Click"/>
                                <Button Content="Protokolle öffnen" Click="OpenLogs_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding HistoryEntries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                                <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="110"/>
                                <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceName}" Width="*"/>
                                <DataGridTextColumn Header="Vorher" Binding="{Binding PreviousVersion}" Width="110"/>
                                <DataGridTextColumn Header="Nachher" Binding="{Binding NewVersion}" Width="110"/>
                                <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="40"/>
                                <DataGridCheckBoxColumn Header="Zurücksetzbar" Binding="{Binding CanRollback, Mode=OneWay}" Width="95"/>
                                <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="1.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- 7 Einstellungen -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Einstellungen" Style="{StaticResource H1}"/>
                            <TextBlock Style="{StaticResource Sub}" Text="Änderungen werden mit „Speichern“ übernommen."/>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Sicherheit" Style="{StaticResource H2}"/>
                                    <CheckBox Content="Vor Installationen einen Wiederherstellungspunkt erstellen" IsChecked="{Binding Settings.CreateRestorePoint}"/>
                                    <CheckBox Content="Alten Treiber vor dem Update sichern (für Zurücksetzen)" IsChecked="{Binding Settings.BackupBeforeInstall}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Automatische Backups behalten:" VerticalAlignment="Center" Width="230"/>
                                        <TextBox Width="60" Text="{Binding Settings.KeepBackups}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Backup-Ordner:" VerticalAlignment="Center" Width="230"/>
                                        <TextBox Width="320" Text="{Binding Settings.BackupFolder}" ToolTip="Leer = C:\ProgramData\ITDriver\Backups"/>
                                        <Button Content="…" Margin="6,0,0,0" Padding="10,4" Click="BrowseBackup_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Geplanter Scan" Style="{StaticResource H2}"/>
                                    <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Text="ITDriver sucht im Hintergrund nach neuen Treibern und meldet sich mit einer Benachrichtigung. Es wird nichts automatisch installiert."/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ScheduleBox" Width="140" SelectedValue="{Binding Settings.Schedule}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Aus" Tag="{x:Static local:Schedules.Off}"/>
                                            <ComboBoxItem Content="Täglich" Tag="{x:Static local:Schedules.Daily}"/>
                                            <ComboBoxItem Content="Wöchentlich" Tag="{x:Static local:Schedules.Weekly}"/>
                                            <ComboBoxItem Content="Monatlich" Tag="{x:Static local:Schedules.Monthly}"/>
                                        </ComboBox>
                                        <ComboBox Width="130" Margin="8,0,0,0" SelectedValue="{Binding Settings.ScheduleDay}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="Montag" Tag="{x:Static local:Schedules.Mon}"/>
                                            <ComboBoxItem Content="Dienstag" Tag="{x:Static local:Schedules.Tue}"/>
                                            <ComboBoxItem Content="Mittwoch" Tag="{x:Static local:Schedules.Wed}"/>
                                            <ComboBoxItem Content="Donnerstag" Tag="{x:Static local:Schedules.Thu}"/>
                                            <ComboBoxItem Content="Freitag" Tag="{x:Static local:Schedules.Fri}"/>
                                            <ComboBoxItem Content="Samstag" Tag="{x:Static local:Schedules.Sat}"/>
                                            <ComboBoxItem Content="Sonntag" Tag="{x:Static local:Schedules.Sun}"/>
                                        </ComboBox>
                                        <TextBlock Text="um" VerticalAlignment="Center" Margin="10,0"/>
                                        <TextBox Width="60" Text="{Binding Settings.ScheduleTime}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="Allgemein" Style="{StaticResource H2}"/>
                                    <CheckBox Content="Beim Start automatisch scannen" IsChecked="{Binding Settings.ScanOnStartup}"/>
                                    <CheckBox Content="Microsoft Update-Katalog nach neueren Treibern durchsuchen (findet deutlich mehr)" IsChecked="{Binding Settings.SearchCatalog}"/>
                                    <CheckBox Content="Herstellerseiten prüfen (AMD Chipsatz &amp; Radeon, ASUS-Mainboards) und Pakete direkt installieren" IsChecked="{Binding Settings.SearchVendors}"/>
                                    <CheckBox Content="Vor dem Installieren einmal nachfragen" IsChecked="{Binding Settings.ConfirmInstall}"/>
                                    <CheckBox Content="Empfehlungen zu Herstellertreibern anzeigen" IsChecked="{Binding Settings.ShowVendorRecommendations}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Treiber als „alt“ markieren ab (Jahre):" VerticalAlignment="Center" Width="230"/>
                                        <TextBox Width="60" Text="{Binding Settings.OldDriverYears}"/>
                                    </StackPanel>
                                    <CheckBox Content="Automatisch nach neuen ITDriver-Versionen suchen (GitHub)" IsChecked="{Binding Settings.AutoCheckAppUpdates}" Margin="0,10,0,0"/>
                                    <CheckBox Content="Neue ITDriver-Versionen automatisch installieren (ohne Nachfrage)" IsChecked="{Binding Settings.AutoInstallAppUpdates}"
                                              IsEnabled="{Binding Settings.AutoCheckAppUpdates}" Margin="20,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Jetzt nach ITDriver-Updates suchen" Click="CheckAppUpdate_Click"/>
                                        <Button Content="Projektseite" Tag="https://github.com/MarcoEckerlin/ITDriver" Click="OpenUrl_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Primary}" Content="Speichern" Click="SaveSettings_Click"/>
                            </StackPanel>

                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,24,0,0" FontSize="12"
                                       Text="ITDriver lädt Treiber ausschließlich über den Windows-Update-Dienst von Microsoft und verlinkt für Herstellertreiber nur die offiziellen Seiten von NVIDIA, AMD, Intel, Realtek &amp; Co. Es werden keine Treiberdateien von Drittservern verteilt. Open Source unter MIT-Lizenz."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
